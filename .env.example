DATABASE_PATH=data/news.db
AUTO_ENABLED=false
AUTO_SOURCE_LIMIT=12
AUTO_MAX_BODY_PER_DAY=120
AUTO_INTERVAL_SECONDS=60
# Tunnel 연결 시 실제 외부 Origin을 쉼표로 구분해 추가하세요.
# 예: https://news.example.com
ALLOWED_ORIGINS=
# AI 요약(GPT)을 쓰려면 OpenAI API 키를 넣으세요. 비워 두면 요약 없이 동작합니다.
OPENAI_API_KEY=
OPENAI_MODEL=gpt-5-mini
